# RESEND_API_KEY: Transactional email provider API key from Resend (resend.com)
# Used by netlify/functions/appointment-request.mjs to notify the salon owner of new appointment requests.
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY="re_your_resend_api_key_here"

# SALON_EMAIL: The destination email address where new customer appointment requests are delivered.
# Configured recipient: artworkexpressllc@gmail.com
SALON_EMAIL="artworkexpressllc@gmail.com"

# SENDER_EMAIL: The verified sender email address or Resend test sender.
# For quick start/testing without domain verification: "Syviana Hair Braiding <onboarding@resend.dev>"
# For production domain: "Syviana Hair Braiding <appointments@syvianaafricahairbraiding.com>"
SENDER_EMAIL="Syviana Hair Braiding <onboarding@resend.dev>"

# APP_URL: The canonical URL where this applet or Netlify site is hosted.
APP_URL="https://syvianaafricahairbraiding.com"
